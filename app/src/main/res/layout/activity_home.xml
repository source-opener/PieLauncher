<merge
	xmlns:tools="http://schemas.android.com/tools"
	xmlns:android="http://schemas.android.com/apk/res/android">
	<de.markusfisch.android.pielauncher.widget.AppPieView
		android:id="@+id/pie"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scrollbars="vertical"/>
	<de.markusfisch.android.pielauncher.widget.SearchInput
		tools:ignore="LabelFor"
		android:id="@+id/search"
		android:background="@android:color/transparent"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingTop="64dp"
		android:paddingBottom="16dp"
		android:inputType="textNoSuggestions|textFilter|textVisiblePassword"
		android:imeOptions="actionSearch|flagNoExtractUi"
		android:privateImeOptions="nm"
		android:gravity="center"
		android:textColor="@color/text_color"
		android:maxLines="1"
		android:maxLength="128"
		android:importantForAutofill="no"
		android:visibility="gone"/>
	<de.markusfisch.android.pielauncher.widget.ActionButton
		android:id="@+id/preferences"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="48dp"
		android:layout_marginRight="16dp"
		android:layout_marginEnd="16dp"
		android:padding="16dp"
		android:layout_gravity="end"
		android:contentDescription="@string/preferences"
		android:src="@drawable/ic_preferences"
		android:visibility="gone"/>
	<LinearLayout
		android:id="@+id/arrange_bar"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="top|center_horizontal"
		android:layout_marginTop="48dp"
		android:background="@drawable/panel"
		android:orientation="horizontal"
		android:padding="8dp"
		android:visibility="gone">
		<TextView
			style="@style/ArrangeButton"
			android:id="@+id/arrange_undo"
			android:drawableTop="@drawable/ic_undo"
			android:text="@string/folder_undo" />
		<TextView
			style="@style/ArrangeButton"
			android:id="@+id/arrange_reset"
			android:drawableTop="@drawable/ic_restore"
			android:text="@string/folder_reset" />
		<TextView
			style="@style/ArrangeButton"
			android:id="@+id/arrange_done"
			android:drawableTop="@drawable/ic_done"
			android:text="@string/folder_done" />
	</LinearLayout>
	<de.markusfisch.android.pielauncher.widget.FolderPanelView
		android:id="@+id/folder_panel"
		android:layout_width="match_parent"
		android:layout_height="match_parent"/>
</merge>
